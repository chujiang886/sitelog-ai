{
  "name": "sitelog-ai",
  "version": "5.4.4",
  "description": "门窗施工归档 AI 助手",
  "scripts": {
    "build": "tailwindcss -i app.css -o vendor/app.css --minify --content ./index.html,./auth-client.js,./frame-client.js",
    "dev": "npx serve -s . -l 3000",
    "start": "npx serve -s . -l 3000",
    "test": "node --test test-share.cjs test-workflow-unit.cjs test-storage.cjs test-frame-client.cjs test-address-client.cjs test-signoff-client.cjs test-hidden-client.cjs test-remediations-client.cjs test-dimensions-client.cjs test-materials-client.cjs",
    "test:parity": "node test-stage-parity.cjs",
    "test:signoff": "node test-signoff-client.cjs",
    "test:frame": "node test-frame-client.cjs",
    "test:address": "node test-address-client.cjs",
    "test:logo": "node test-logo-upload.cjs",
    "test:logo:mutate": "python3 mutate-logo-upload.py"
  },
  "devDependencies": {
    "alpinejs": "^3.13.5",
    "dompurify": "3.4.15",
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^3.4.17"
  }
}

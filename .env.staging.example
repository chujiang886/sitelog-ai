# ═══════════════════════════════════════════════════════════════════════════
# Phase 3.9.9 Real Staging Runtime Integration & Validation Layer
# Local Staging 环境变量模板（示例，**不含任何真实密钥/生产资源**）
# ═══════════════════════════════════════════════════════════════════════════
#
# 用法：复制为 .env.staging 并填入本地预生产值；缺省全部 pending_verification。
# 本文件仅作模板提交入 git；真实值写入 .env.staging（已 gitignore，不入仓库）。
# 红线：以下变量不得等于任何 Production 等效资源（DB DSN / Secret / IdP /
#       Storage / Alert），隔离护栏会在加载时结构性校验。

# ── 环境分类（只能是 local_staging；绝不 production）──
STAGING_ENVIRONMENT=local_staging

# ── 五类非生产资源（经隔离校验不得等于 Production）──
# 本地预生产数据库（非生产 DSN，禁止等于生产库）
STAGING_DB_DSN=pending_verification
# 非生产 Secret 引用（禁止等于生产 Secret）
STAGING_SECRET_REF=pending_verification
# 非生产 IdP issuer（禁止等于生产 IdP）
STAGING_IDP_ISSUER=pending_verification
# 非生产存储桶（禁止等于生产存储）
STAGING_STORAGE_BUCKET=pending_verification
# 非生产告警通道（禁止等于生产告警）
STAGING_ALERT_CHANNEL=pending_verification

# ── 具体 Staging Secret（按逻辑名解析：STAGING_SECRET_<NAME>）──
# 例如接入本地预生产的 LLM/数据源密钥时在此填写；缺省 pending 即未配置。
STAGING_SECRET_LLM_API_KEY=pending_verification
STAGING_SECRET_DB_PASSWORD=pending_verification
